# Copie para .env SÓ para rodar localmente. No Umbrel, cadastre no Portainer.
# Nunca coloque valores reais neste arquivo nem em nenhum .txt.

# Pluggy (dashboard.pluggy.ai, depois de conectar os bancos em meu.pluggy.ai)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Firefly III (Profile -> OAuth -> Personal Access Tokens)
FIREFLY_BASE_URL=http://127.0.0.1:30009
FIREFLY_TOKEN=

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# opcional: id do seu usuário (num chat privado é igual ao TELEGRAM_CHAT_ID)
TELEGRAM_USER_ID=

# Mapeamento de contas em JSON numa linha (ou grave /data/account_mapping.json no volume)
ACCOUNT_MAPPING_JSON=

# Regras de dinheiro
MONTHLY_SAVINGS_TARGET=175.89
SAFETY_BUFFER=0

# Horários em UTC (Brasília = UTC-3)
REPORT_HOUR_UTC=8
SYNC_EVERY_HOURS=3

# IA local no KaviPC (deixe LLM_BASE_URL vazio para desligar)
LLM_BASE_URL=
LLM_MODEL=qwen2.5:7b-instruct
