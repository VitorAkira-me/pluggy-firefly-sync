# Credenciais da aplicação criada em https://dashboard.pluggy.ai
# (depois de conectar suas contas reais em https://meu.pluggy.ai)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Firefly III
FIREFLY_BASE_URL=http://umbrel.local:30009
FIREFLY_TOKEN=

# Canal do relatório diário: "telegram" (padrão) ou "webhook"
NOTIFY_CHANNEL=telegram

# Telegram (usado se NOTIFY_CHANNEL=telegram; pode reaproveitar o bot de promoções, ou criar um novo com o @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook do n8n/Node-RED (usado se NOTIFY_CHANNEL=webhook) — a URL do gatilho
# que recebe o relatório em JSON e decide pra onde mandar (WhatsApp, etc.)
WEBHOOK_URL=

# Regra de poupança obrigatória mensal (R$), dividida entre as caixinhas ativas
MONTHLY_SAVINGS_TARGET=175.89

# Reserva mínima que não deve ser contada como "livre para gastar" (colchão de segurança)
SAFETY_BUFFER=0
